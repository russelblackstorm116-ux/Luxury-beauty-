rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Products collection (TikTok Amazon recommendations)
    match /products/{productId} {
      allow read: if true;
      allow write: if true;
    }

    // Settings collection (creator profile, social links, Amazon disclosure)
    match /settings/{settingId} {
      allow read: if true;
      allow write: if true;
    }

    // Default deny any other unspecified collections
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
